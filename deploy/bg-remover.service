[Unit]
Description=Background remover (BiRefNet)
After=network-online.target
Wants=network-online.target

[Service]
User=bgremover
Group=bgremover
WorkingDirectory=/opt/bg-remover
Environment=U2NET_HOME=/opt/bg-remover/models
Environment=BG_WORKERS=1
Environment=BG_QUEUE=8
ExecStart=/opt/bg-remover/.venv/bin/uvicorn server:app --host 127.0.0.1 --port 8000 --proxy-headers
Restart=always
RestartSec=3
# First start downloads the ~1 GB model.
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
